+import { AccountType, MobileMoneyDirection, MobileMoneyPaymentStatus, Prisma, TransactionType } from '@prisma/client';
+import { UNUSED_VALUE_AUTHORITY_VERSION } from './unused-value-authority-write';
+
+type Payment = Prisma.MobileMoneyPaymentGetPayload<Record<string, never>>;
+type Settlement = Prisma.TransactionGetPayload<{ include: { entries: { include: { debitAccount: { select: { accountType: true } } } } } }>;
+type Window = Prisma.TopupRefundWindowGetPayload<Record<string, never>>;
+
+/** The same immutable financial bindings govern replay, evaluation and reconciliation. */
+export function validateTopupAuthority(input: {
+  payment: Payment;
+  wallet: { id: string; userId: string; accountType: AccountType };
+  settlement: Settlement | null;
+  window: Window | null;
+  authority: { authorityVersion: number; permanentDebitVersion: bigint; policyExclusionVersion: bigint } | null;
+  cutover: { authorityVersion: number; cutoverVersion: number; activatedAt: Date | null };
+}): string | null {
+  const { payment, wallet, settlement, window, authority, cutover } = input;
+  if (cutover.authorityVersion !== UNUSED_VALUE_AUTHORITY_VERSION ||
+      (authority && authority.authorityVersion !== cutover.authorityVersion)) {
+    return 'Authority version does not match the supported cutover';
+  }
+  if (payment.direction !== MobileMoneyDirection.TOPUP ||
+      payment.status !== MobileMoneyPaymentStatus.SUCCEEDED || !payment.providerReference ||
+      payment.userId !== wallet.userId || wallet.accountType !== AccountType.USER_WALLET ||
+      !settlement || payment.settledTransactionId !== settlement.id) {
+    return 'Payment and wallet do not bind a successful TOPUP settlement';
+  }
+  const expectedFloat = payment.provider === 'ORANGE' ? AccountType.ORANGE_FLOAT : AccountType.MTN_FLOAT;
+  if (settlement.type !== TransactionType.TOPUP ||
+      settlement.idempotencyKey !== `mobile-money:TOPUP:${payment.id}` ||
+      settlement.totalAmountLrd !== payment.amountLrd || settlement.totalAmountUsd !== 0 ||
+      settlement.entries.length !== 1 ||
+      settlement.entries[0].debitAccount.accountType !== expectedFloat ||
+      settlement.entries[0].creditAccountId !== wallet.id ||
+      settlement.entries[0].amountLrd !== payment.amountLrd || settlement.entries[0].amountUsd !== 0) {
+    return 'TOPUP settlement ledger identity is invalid';
+  }
+  const postCutover = cutover.activatedAt !== null && settlement.createdAt >= cutover.activatedAt;
+  if (!postCutover) return window ? 'Pre-cutover TOPUP unexpectedly has a refund window' : null;
+  if (!authority || !window) return 'Post-cutover TOPUP authority or refund window is missing';
+  if (window.paymentId !== payment.id || window.walletId !== wallet.id ||
+      window.settledTransactionId !== settlement.id ||
+      window.createdAt.getTime() !== settlement.createdAt.getTime() ||
+      window.authorityVersion !== cutover.authorityVersion ||
+      window.cutoverVersion !== cutover.cutoverVersion ||
+      window.debitVersionAtSettlement < 0n || window.exclusionVersionAtSettlement < 0n ||
+      window.debitVersionAtSettlement > authority.permanentDebitVersion ||
+      window.exclusionVersionAtSettlement > authority.policyExclusionVersion) {
+    return 'Refund window bindings do not match canonical settlement and authority';
+  }
+  return null;

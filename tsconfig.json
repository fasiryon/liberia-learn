{
    "compilerOptions":  {
                            "target": "ES2020",
                            "lib":  [
                                        "dom",
                                        "dom.iterable",
                                        "esnext"
                                    ],
                            "allowJs":  true,
                            "skipLibCheck":  true,
                            "strict":  false,
                            "noImplicitAny":  false,
                            "noEmit":  true,
                            "esModuleInterop":  true,
                            "module":  "esnext",
                            "moduleResolution":  "bundler",
                            "resolveJsonModule":  true,
                            "isolatedModules":  true,
                            "jsx":  "preserve",
                            "incremental":  true,
                            "plugins":  [
                                            {
                                                "name":  "next"
                                            }
                                        ],
                            "paths":  {
                                          "@/*":  [
                                                      "./*"
                                                  ]
                                      }
                        },
    "include":  [
                    "next-env.d.ts",
                    "**/*.ts",
                    "**/*.tsx",
                    ".next/types/**/*.ts",
                    ".next/dev/types/**/*.ts",
                    "**/*.mts"
                ],
    "exclude":  [
                    "node_modules",
                    "_app_backup_*",
                    "_patches",
                    "**/_app_backup_*",
                    "**/_patches",
                    "LL_AUDIT_DUMP*.txt",
                    "_frontend_old",
                    "_frontend_old/**",
                    "_patches/**",
                    "**/_frontend_old",
                    "app.BACKUP-*",
                    "app.BACKUP-*/**",
                    "lib.BACKUP-*",
                    "lib.BACKUP-*/**",
                    "**/app.BACKUP-*",
                    "**/lib.BACKUP-*",
                    "**/*.BACKUP-*",
                    "prisma/**/*.ts",
                    "prisma/**/*.tsx",
                    "src/app/api/grading/**",
                    "src/lib/grading/**",
                    "src/server/grading/**",
                    "src/server/services/mastery/**",
                    "lib/factory/**",
                    "_ARCHIVE_*",
                    "_ARCHIVE_*/**",
                    "**/_ARCHIVE_*",
                    "**/_ARCHIVE_*/**",
                    ".next",
                    ".next/**",
                    "src",
                    "src/**",
                    "lib/factory",
                    "app/api/governance",
                    "app/api/governance/**",
                    "app/api/grading",
                    "app/api/grading/**",
                    "e2e",
                    "e2e/**",
                    "playwright.config.ts"
                ]
}


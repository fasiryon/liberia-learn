        ],
        "scaffolding": "INDEPENDENT",
        "instructions": {
          "learner": [
            {
              "stepId": "homework-step-1",
              "text": "Write 26.53 as tens, ones, tenths and hundredths.",
              "resourceIds": []
            },
            {
              "stepId": "homework-step-2",
              "text": "Compare 0.3 with 0.28 and justify your decision.",
              "resourceIds": []
            },
            {
              "stepId": "homework-step-3",
              "text": "Write a pair of decimals where the longer written decimal is smaller. Ask someone to listen to your reasoning without giving the answer.",

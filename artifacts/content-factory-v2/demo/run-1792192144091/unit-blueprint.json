      "sourcePointer": "/lessons/0/packageGaps",
      "scope": "REQUIRED",
      "mapping": "PROPOSED"
    },
    {
      "id": "ll-g7-base-generalisation-extension",
      "kind": "LIBERIALEARN_EXTENSION",
      "statement": "Investigate how place units change in a base other than ten.",
      "sourceId": "g7-existing-gap-report-source",
      "sourcePointer": "/lessons/0/packageGaps/3",
      "scope": "OPTIONAL_EXTENSION",
      "mapping": "PROPOSED"
    }
  ],

      "content": {
        "title": "Create a decimal misconception guide",
        "objectiveIds": [
          "proposed-g7-number-sense-place-value"
        ],
        "lessonItemIds": [
          "lesson-2"
        ],
        "scaffolding": "INDEPENDENT",
        "instructions": {
          "learner": [
            {
              "stepId": "project-step-1",
              "text": "Create a one-page guide showing two invented decimal comparisons where digit count gives the wrong answer.",
              "resourceIds": []
            },
            {
              "stepId": "project-step-2",
              "text": "For each comparison, show equal-unit reasoning. Include an original place-value diagram or a text table.",
              "resourceIds": []
            },
            {
              "stepId": "project-step-3",
              "text": "Exchange guides for comments, then submit your own revision with the help you received recorded. Practice feedback does not establish independent mastery.",
              "resourceIds": []
            }
          ],
          "teacher": [
            {
              "stepId": "project-teacher",
              "text": "Record assistance separately. Ask for reasoning before feedback. Use the protected assessment rubric only for independently collected assessment responses.",
              "resourceIds": []
            }
          ]
        },

      "content": {
        "title": "Paper decimal strips",
        "objectiveIds": [
          "proposed-g7-number-sense-place-value"
        ],
        "lessonItemIds": [
          "lesson-2"
        ],
        "scaffolding": "GUIDED",
        "instructions": {
          "learner": [
            {
              "stepId": "practical-step-1",
              "text": "Draw two equal-length strips divided into ten equal sections. Mark quantities 0.4 and 0.35, subdividing sections into hundredths when needed.",
              "resourceIds": []
            },
            {
              "stepId": "practical-step-2",
              "text": "Label the units in text; do not rely on colour. Explain which marked length is greater.",
              "resourceIds": []
            },
            {
              "stepId": "practical-step-3",
              "text": "If drawing is difficult, dictate a table of tenths and hundredths instead. Record a written justification. This is practice, not a certified lab.",
              "resourceIds": []
            }
          ],
          "teacher": [
            {
              "stepId": "practical-teacher",
              "text": "Record assistance separately. Ask for reasoning before feedback. Use the protected assessment rubric only for independently collected assessment responses.",
              "resourceIds": []
            }
          ]
        },
        "resourceIds": [],
        "rubric": null,
        "expectedDurationMinutes": 20,

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// / ===== Core Identity & Org =====
model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  loginId             String?              @unique
  emailVerified       DateTime?
  hashedPwd           String?
  name                String?
  role                Role
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  passwordChangedAt   DateTime?
  mustChangePIN       Boolean              @default(false)
  schoolId            String?
  isPlatformAdmin     Boolean              @default(false)
  guardianCountryCode String               @default("+231")
  guardianPhone       String?
  guardianPhoneE164   String?
  preferredChannel    String               @default("EMAIL")
  smsOptIn            Boolean              @default(false)
  guardianSmsPreferences Json?
  accounts            Account[]
  auditLogs           AuditLog[]
  teacherOf           Class[]              @relation("TeacherClasses")
  markedAttendance    Attendance[]         @relation("AttendanceMarkedBy")
  timetableEntries    Timetable[]          @relation("TimetableTeacher")
  teacherAssignments  TeacherAssignment[]  @relation("TeacherAssignmentTeacher")
  homework            Homework[]
  messagesSent        Message[]            @relation("MessagesSent")
  messagesReceived    Message[]            @relation("MessagesReceived")
  notificationLogs    NotificationLog[]
  guardianConsents    GuardianConsent[]    @relation("GuardianConsentGuardian")
  smsDeliveryLogs     SMSDeliveryLog[]     @relation("SMSDeliveryLogGuardian")
  exportRecords       ExportRecord[]
  metricEvents        MetricEvent[]
  passwordResetTokens PasswordResetToken[]
  sessions            Session[]
  student             Student?
  guardianOf          StudentGuardian[]
  studentProgress     StudentProgress[]
  TeacherProfile      TeacherProfile?
  TrainingProgress    TrainingProgress[]
  school              School?              @relation(fields: [schoolId], references: [id])
  // Part 4: units created by this user
  curriculumUnits     CurriculumUnit[]     @relation("CurriculumUnitCreatedBy")
  curriculumVersionsCreated CurriculumVersion[] @relation("CurriculumVersionCreatedBy")
  policyConfigsCreated PolicyConfig[] @relation("PolicyConfigCreatedBy")
  policyConfigsUpdated PolicyConfig[] @relation("PolicyConfigUpdatedBy")
  policyOverridesCreated PolicyOverride[] @relation("PolicyOverrideCreatedBy")
  // Part 7: lab sessions for this user
  labSessions         LabSession[]         @relation("LabSessionStudent")
  // Guardian messaging
  sentGuardianMessages     GuardianMessage[] @relation("GuardianMessageGuardian")
  receivedGuardianMessages GuardianMessage[] @relation("GuardianMessageTeacher")
  lessonVideos        LessonVideo[]          @relation("LessonVideoTeacher")
  teacherWelcomeCompletedAt DateTime?
  teacherSentiments   TeacherSentiment[]
}

model District {
  id               String            @id @default(cuid())
  tenantId         String
  name             String
  region           String
  code             String?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  schools          School[]
  interventionLogs InterventionLog[]
  policyConfigs    PolicyConfig[]
  policyOverrides  PolicyOverride[]

  @@index([tenantId])
  @@index([isActive])
}

model School {
  id                     String                 @id @default(cuid())
  name                   String
  code                   String?                @unique
  timezone               String                 @default("Africa/Monrovia")
  primaryHex             String?
  secondaryHex           String?
  accentHex              String?
  logoUrl                String?
  createdAt              DateTime               @default(now())
  contactEmail           String?
  contactName            String?
  contactPhone           String?
  county                 String?
  district               String?
  districtId             String?
  motto                  String?
  status                 String                 @default("ACTIVE")
  welcomeMsg             String?
  allowBlueprintAdoption Boolean                @default(true)
  allowTeacherPublish    Boolean                @default(false)
  approvalRequired       Boolean                @default(true)
  onboardingStep         Int                    @default(0)
  pilotStatus            String?
  pilotCohort            String?
  pilotStartDate         DateTime?
  pilotNotes             String?
  contactEmailVerified   Boolean                @default(false)
  contactPhoneVerified   Boolean                @default(false)
  schoolType             String?
  estimatedEnrollment    Int?
  approvedAt             DateTime?
  rejectedAt             DateTime?
  rejectionReason        String?
  AuditLog               AuditLog[]
  classes                Class[]
  inviteTokens           InviteToken[]
  PilotChecklistStatus   PilotChecklistStatus[]
  TeacherProfile         TeacherProfile[]
  users                  User[]
  guardianConsents       GuardianConsent[]
  smsDeliveryLogs        SMSDeliveryLog[]
  metricEvents           MetricEvent[]
  District               District?              @relation(fields: [districtId], references: [id])
  interventionLogs       InterventionLog[]
  // Part 4: unit grouping
  curriculumUnits        CurriculumUnit[]
  // Part 5: assignment suggestions
  assignmentSuggestions  AssignmentSuggestion[]
  // Part 7: virtual lab sessions
  labSessions            LabSession[]
  guardianMessages       GuardianMessage[]
  exams                  Exam[]
  ragChunks              RagChunk[]
  sloEvents              SloEvent[]
  academicYears          AcademicYear[]
  academicEnrollments    AcademicEnrollment[]
  transcripts            Transcript[]
  attendanceEntries      Attendance[]
  policyConfigs          PolicyConfig[]
  policyOverrides        PolicyOverride[]
  timetableEntries       Timetable[]
  teacherAssignments     TeacherAssignment[]
  studentImportBatches   StudentImportBatch[]
}

model Class {
  id            String          @id @default(cuid())
  schoolId      String
  name          String
  subject       Subject
  gradeLevel    Int?
  teacherId     String?
  createdAt     DateTime        @default(now())
  assessments   Assessment[]
  assignments   Assignment[]
  School        School          @relation(fields: [schoolId], references: [id])
  Teacher       User?           @relation("TeacherClasses", fields: [teacherId], references: [id])
  enrollments   Enrollment[]
  grades        Grade[]
  homework      Homework[]
  meetings      Meeting[]
  attendanceEntries Attendance[]
  messages      Message[]
  scheduledWork ScheduledWork[]
  timetableEntries Timetable[]
  teacherAssignments TeacherAssignment[]
  exams          Exam[]
}

model Student {
  id                    String                  @id @default(cuid())
  userId                String                  @unique
  county                String?
  community             String?
  dateOfBirth           DateTime?
  createdAt             DateTime                @default(now())
  currentGrade          Int?
  deletedAt             DateTime?
  assignmentSubmissions AssignmentSubmission[]
  attendance            AttendanceRecord[]
  operationalAttendance Attendance[]
  capstoneProjects      CapstoneProject[]
  chatMessages          ChatMessage[]
  enrollments           Enrollment[]
  grades                Grade[]
  homeworkSubmissions   HomeworkSubmission[]
  mastery               MasteryRecord[]
  masteryProfiles       StudentMasteryProfile[]
  adaptiveAttempts      StudentAdaptiveAttempt[]
  placementTests        PlacementTest[]
  portfolioItems        PortfolioItem[]
  reviews               ReviewSchedule[]
  user                  User                    @relation(fields: [userId], references: [id])
  guardians             StudentGuardian[]
  guardianConsents      GuardianConsent[]       @relation("GuardianConsentStudent")
  smsDeliveryLogs       SMSDeliveryLog[]
  submissions           Submission[]
  inviteTokens          InviteToken[]           @relation("InviteTokenStudent")
  guardianMessages      GuardianMessage[]
  examAttempts          ExamAttempt[]
  examCertifications    ExamCertification[]
  certificates          Certificate[]
  performanceEvents     StudentPerformanceEvent[]
  confusionSignals      ConfusionSignal[]
  interventionRecommendations InterventionRecommendation[]
  academicEnrollments   AcademicEnrollment[]
  transcripts           Transcript[]
}

model Exam {
  id              String              @id @default(cuid())
  title           String
  subject         String
  grade           Int
  schoolId        String
  academicYearId  String?
  classId         String?
  createdBy       String
  status          ExamStatus          @default(DRAFT)
  moeStandards    String[]
  timeLimit       Int
  passingScore    Float               @default(0.70)
  publishedAt     DateTime?
  resultsPublishedAt DateTime?
  deletedAt       DateTime?
  questions       ExamQuestion[]
  attempts        ExamAttempt[]
  certifications  ExamCertification[]
  school          School              @relation(fields: [schoolId], references: [id])
  academicYear    AcademicYear?       @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  class           Class?              @relation(fields: [classId], references: [id], onDelete: SetNull)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([schoolId, subject, grade])
  @@index([schoolId, status, grade])
  @@index([academicYearId, classId])
}

model ExamQuestion {
  id           String @id @default(cuid())
  examId       String
  prompt       String
  options      String[]
  correctIndex Int
  explanation  String
  moeCode      String
  points       Int    @default(1)
  exam         Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([examId])
}

model ExamAttempt {
  id             String   @id @default(cuid())
  examId         String
  studentId      String
  answers        Int[]
  score          Float
  passed         Boolean
  startedAt      DateTime @default(now())
  submittedAt    DateTime?
  tabSwitchCount Int      @default(0)
  durationSeconds Int?
  integrityFlags String[]
  integrityMetadata Json?
  submissionLog  Json?
  exam           Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([examId, studentId])
  @@index([studentId, submittedAt])
  @@index([examId, submittedAt])
}

model ExamCertification {
  id        String   @id @default(cuid())
  studentId String
  examId    String
  subject   String
  grade     Int
  score     Float
  issuedAt  DateTime @default(now())
  certCode  String   @unique
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([examId])
}

model Certificate {
  id              String          @id @default(cuid())
  studentId       String
  type            CertificateType
  referenceId     String
  awardedAt       DateTime        @default(now())
  certificateCode String          @unique
  student         Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, type, referenceId])
  @@index([studentId, awardedAt])
  @@index([type, referenceId])
}

model StudentGuardian {
  id         String  @id @default(cuid())
  studentId  String
  guardianId String
  relation   String?
  guardian   User    @relation(fields: [guardianId], references: [id])
  student    Student @relation(fields: [studentId], references: [id])

  @@unique([studentId, guardianId])
}

/// / ===== Scheduling & Enrollment =====
model Enrollment {
  id        String   @id @default(cuid())
  studentId String
  classId   String
  createdAt DateTime @default(now())
  Class     Class    @relation(fields: [classId], references: [id])
  Student   Student  @relation(fields: [studentId], references: [id])

  @@unique([studentId, classId])
  // Block 23: classId-first index for class roster lookups in risk/growth routes
  @@index([classId])
}

model AcademicYear {
  id          String               @id @default(cuid())
  schoolId    String
  yearLabel   String
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean              @default(false)
  createdAt   DateTime             @default(now())
  school      School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  terms       Term[]
  enrollments AcademicEnrollment[]
  transcripts Transcript[]
  exams       Exam[]

  @@unique([schoolId, yearLabel])
  @@index([schoolId, isActive])
  @@index([schoolId, startDate])
}

model Term {
  id             String       @id @default(cuid())
  academicYearId String
  name           String
  startDate      DateTime
  endDate        DateTime
  createdAt      DateTime     @default(now())
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([academicYearId, name])
  @@index([academicYearId, startDate])
}

model AcademicEnrollment {
  id             String                   @id @default(cuid())
  studentId      String
  schoolId       String
  academicYearId String
  grade          Int
  status         AcademicEnrollmentStatus @default(ACTIVE)
  createdAt      DateTime                 @default(now())
  student        Student                  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  school         School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear             @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([studentId, schoolId, academicYearId])
  @@index([schoolId, academicYearId, status])
  @@index([studentId, academicYearId])
}

model Transcript {
  id             String       @id @default(cuid())
  studentId      String
  schoolId       String
  academicYearId String
  grade          Int
  gpa            Float?
  summary        Json?
  createdAt      DateTime     @default(now())
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([studentId, academicYearId])
  @@index([schoolId, academicYearId])
  @@index([studentId, createdAt])
}

model Meeting {
  id         String             @id @default(cuid())
  classId    String
  startsAt   DateTime
  endsAt     DateTime
  attendance AttendanceRecord[]
  Class      Class              @relation(fields: [classId], references: [id])

  // Block 23: composite index for attendance window queries (classId + time range)
  @@index([classId, startsAt])
}

model Attendance {
  id         String           @id @default(cuid())
  studentId  String
  classId    String
  schoolId   String
  date       DateTime
  status     AttendanceStatus
  markedById String
  notes      String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  student    Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class      Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  school     School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  markedBy   User             @relation("AttendanceMarkedBy", fields: [markedById], references: [id], onDelete: Cascade)

  @@unique([studentId, classId, date])
  @@index([schoolId, date])
  @@index([classId, date])
  @@index([markedById, date])
}

model AttendanceRecord {
  id        String           @id @default(cuid())
  meetingId String
  studentId String
  status    AttendanceStatus
  markedAt  DateTime         @default(now())
  Meeting   Meeting          @relation(fields: [meetingId], references: [id])
  Student   Student          @relation(fields: [studentId], references: [id])

  @@unique([meetingId, studentId], name: "meetingId_studentId")
}

/// / ===== Curriculum =====
model Standard {
  id          String    @id @default(cuid())
  code        String    @unique
  description String
  subject     Subject
  band        GradeBand
  units       Unit[]
  skills      Skill[]   @relation("SkillToStandard")

  @@index([subject, band])
}

model Skill {
  id         String           @id @default(cuid())
  subject    Subject
  band       GradeBand
  descriptor String
  examples   Json?
  mastery    MasteryRecord[]
  practice   PracticeItem[]
  reviews    ReviewSchedule[]
  standards  Standard[]       @relation("SkillToStandard")
}

model Unit {
  id          String       @id @default(cuid())
  standardId  String?
  subject     Subject
  band        GradeBand
  title       String
  weeks       Int          @default(2)
  assessments Assessment[]
  lessons     Lesson[]
  Standard    Standard?    @relation(fields: [standardId], references: [id])
}

model Lesson {
  id           String @id @default(cuid())
  unitId       String
  title        String
  objectives   Json
  durationMins Int    @default(45)
  Unit         Unit   @relation(fields: [unitId], references: [id])
}

model PracticeItem {
  id             String           @id @default(cuid())
  skillId        String
  stimulus       String
  itemType       ItemType
  difficulty     Difficulty
  answerKey      Json?
  hints          Json?
  AssessmentItem AssessmentItem[]
  QuestionTag    QuestionTag[]
  Skill          Skill            @relation(fields: [skillId], references: [id])
}

model Assessment {
  id          String           @id @default(cuid())
  classId     String?
  unitId      String?
  title       String
  createdAt   DateTime         @default(now())
  Class       Class?           @relation(fields: [classId], references: [id])
  Unit        Unit?            @relation(fields: [unitId], references: [id])
  items       AssessmentItem[]
  submissions Submission[]
}

model AssessmentItem {
  id             String        @id @default(cuid())
  assessmentId   String
  practiceItemId String?
  rubric         Json?
  points         Int           @default(1)
  Assessment     Assessment    @relation(fields: [assessmentId], references: [id])
  PracticeItem   PracticeItem? @relation(fields: [practiceItemId], references: [id])
}

model Submission {
  id           String     @id @default(cuid())
  assessmentId String
  studentId    String
  responses    Json
  score        Int?
  gradedAt     DateTime?
  Assessment   Assessment @relation(fields: [assessmentId], references: [id])
  Student      Student    @relation(fields: [studentId], references: [id])

  @@unique([assessmentId, studentId])
}

model Grade {
  id         String   @id @default(cuid())
  classId    String
  studentId  String
  percent    Float
  letter     String
  computedAt DateTime @default(now())
  Class      Class    @relation(fields: [classId], references: [id])
  Student    Student  @relation(fields: [studentId], references: [id])

  @@index([classId, studentId])
}

/// / ===== Mastery Engine  Block 7A =====

/// Strand taxonomy  subject  strand  grade-band catalogue.
/// Seeded by prisma/seeds/strand-catalog.ts. WAEC refs are G10-12 only.
model StrandCatalog {
  id              String                  @id @default(cuid())
  subject         Subject
  strandKey       String
  name            String
  gradeBand       GradeBand
  waecRef         String?
  isActive        Boolean                 @default(true)
  createdAt       DateTime                @default(now())
  questionTags    QuestionTag[]
  masteryProfiles StudentMasteryProfile[]

  @@unique([subject, strandKey], name: "StrandCatalog_subject_strandKey_key")
  @@index([subject, gradeBand])
  @@index([isActive, subject])
}

/// Tagging model linking question/item IDs to strand + difficulty metadata.
model QuestionTag {
  id             String        @id @default(cuid())
  subject        Subject
  strandKey      String
  difficulty     Difficulty
  itemType       ItemType
  practiceItemId String?
  createdAt      DateTime      @default(now())
  PracticeItem   PracticeItem? @relation(fields: [practiceItemId], references: [id], onDelete: SetNull)
  StrandCatalog  StrandCatalog @relation(fields: [subject, strandKey], references: [subject, strandKey])

  @@index([subject, strandKey])
  @@index([practiceItemId])
}

/// Per-student mastery state for a specific subject  strand.
/// Pure-function metrics recomputed on every attempt write.
/// baselineConfidence and baselineCompletedAt are optional (populated by Block 7B adaptive baseline).
model StudentMasteryProfile {
  id                  String           @id @default(cuid())
  studentId           String
  subject             Subject
  strandKey           String
  baselineScore       Float            @default(0)
  currentScore        Float            @default(0)
  proficiencyState    ProficiencyState @default(NOT_ASSESSED)
  masteryState        MasteryState     @default(NOT_ASSESSED)
  sustainabilityIndex Float            @default(0)
  decayRate           Float            @default(0)
  aiRelianceRate      Float            @default(0)
  lastAssessedAt      DateTime?
  baselineConfidence  Float?
  baselineCompletedAt DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  student             Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  StrandCatalog       StrandCatalog    @relation(fields: [subject, strandKey], references: [subject, strandKey])

  @@unique([studentId, subject, strandKey], name: "StudentMasteryProfile_studentId_subject_strandKey_key")
  @@index([studentId])
  @@index([subject, strandKey])
  @@index([masteryState])
  @@index([proficiencyState])
}

/// / ===== Mastery & Spaced Review =====
model MasteryRecord {
  id             String    @id @default(cuid())
  studentId      String
  skillId        String
  level          Int       @default(0)
  lastAssessedAt DateTime?
  Skill          Skill     @relation(fields: [skillId], references: [id])
  Student        Student   @relation(fields: [studentId], references: [id])

  @@unique([studentId, skillId])
}

model ReviewSchedule {
  id           String   @id @default(cuid())
  studentId    String
  skillId      String
  nextAt       DateTime
  intervalDays Int      @default(7)
  Skill        Skill    @relation(fields: [skillId], references: [id])
  Student      Student  @relation(fields: [studentId], references: [id])

  @@unique([studentId, skillId])
}

/// / ===== Communication & Audit =====
model Message {
  id         String   @id @default(cuid())
  classId    String?
  fromUserId String
  toUserId   String
  body       String
  createdAt  DateTime @default(now())
  Class      Class?   @relation(fields: [classId], references: [id])
  fromUser   User     @relation("MessagesSent", fields: [fromUserId], references: [id])
  toUser     User     @relation("MessagesReceived", fields: [toUserId], references: [id])
}

model AuditLog {
  id           String   @id @default(cuid())
  userId       String?
  action       String
  details      Json?
  createdAt    DateTime @default(now())
  ipAddress    String?
  resourceId   String?
  resourceType String?
  schoolId     String?
  traceId      String? // Block 6: request-correlation trace ID
  School       School?  @relation(fields: [schoolId], references: [id])
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([resourceType, resourceId])
  @@index([userId, createdAt])
  @@index([schoolId, action, createdAt])
  @@index([traceId])
}

model TrainingModule {
  id               String             @id @default(cuid())
  title            String
  description      String?
  content          String?
  sortOrder        Int                @default(0)
  estimatedMinutes Int                @default(0)
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  code             String?            @unique
  TrainingProgress TrainingProgress[]

  @@index([isActive, sortOrder])
}

/// / ===== Assignments =====
model Assignment {
  id               String                 @id @default(cuid())
  classId          String
  title            String
  description      String?
  dueAt            DateTime?
  points           Int                    @default(100)
  createdAt        DateTime               @default(now())
  // Part 5: lesson linkage
  scheduledWorkId  String?
  contentId        String?
  moeStandardCodes String[]               @default([])
  generationMethod String?                // "manual"|"ai_generated"|"suggested"
  Class            Class                  @relation(fields: [classId], references: [id])
  submissions      AssignmentSubmission[]
}

model AssignmentSubmission {
  id           String     @id @default(cuid())
  assignmentId String
  studentId    String
  turnedInAt   DateTime?
  content      String?
  score        Int?
  feedback     String?
  gradedAt     DateTime?
  gradedBy     String?
  Assignment   Assignment @relation(fields: [assignmentId], references: [id])
  Student      Student    @relation(fields: [studentId], references: [id])

  @@unique([assignmentId, studentId])
  // Block 23: student-first + time index for assignment completion queries in risk routes
  @@index([studentId, turnedInAt])
}

/// / ===== Homework (AI + Teacher) =====
model Homework {
  id               String               @id @default(cuid())
  classId          String
  title            String
  dueAt            DateTime?
  createdAt        DateTime             @default(now())
  instructions     String?
  questions        Json?
  description      String?
  createdById      String
  rubricJson       Json?
  // Part 5: lesson linkage
  scheduledWorkId  String?
  contentId        String?
  moeStandardCodes String[]             @default([])
  generationMethod String?
  Class            Class                @relation(fields: [classId], references: [id])
  createdBy        User                 @relation(fields: [createdById], references: [id])
  submissions      HomeworkSubmission[]
}

model HomeworkSubmission {
  id           String   @id @default(cuid())
  homeworkId   String
  studentId    String
  aiFeedback   Json?
  aiScore      Float?
  answers      Json?
  submittedAt  DateTime @default(now())
  teacherNotes String?
  teacherScore Float?
  aiReviewed   Boolean  @default(false)
  Homework     Homework @relation(fields: [homeworkId], references: [id])
  Student      Student  @relation(fields: [studentId], references: [id])

  @@unique([homeworkId, studentId])
  // Block 23: student-first + time index for evidence-velocity queries in risk routes
  @@index([studentId, submittedAt])
}

/// / ===== Capstone / Portfolio / Partners =====
model CapstoneProject {
  id         String          @id @default(cuid())
  studentId  String
  title      String
  summary    String?
  repoUrl    String?
  mentorId   String?
  startedAt  DateTime        @default(now())
  finishedAt DateTime?
  status     String          @default("ACTIVE")
  Student    Student         @relation(fields: [studentId], references: [id])
  artifacts  PortfolioItem[]
}

model PortfolioItem {
  id                String           @id @default(cuid())
  studentId         String
  kind              String

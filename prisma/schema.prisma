/// Sprint 2: teacher-originated action record.
/// Narrow, additive action log for workflow attribution.
model TeacherAction {
  id            String    @id @default(cuid())
  teacherUserId String
  schoolId      String
  classId       String?
  studentId     String?
  contentId     String?
  actionType    String
  targetType    String?
  targetId      String?
  subject       String?
  metadata      Json?
  occurredAt    DateTime  @default(now())
  createdAt     DateTime  @default(now())

  @@index([teacherUserId, occurredAt])
  @@index([schoolId, actionType, occurredAt])
  @@index([studentId, occurredAt])
  @@index([contentId, occurredAt])
}

model InterventionRecommendation {

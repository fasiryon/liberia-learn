  school     School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class      Class      @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher    User       @relation("TimetableTeacher", fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([schoolId, dayOfWeek])
  @@index([teacherId, dayOfWeek])
  @@unique([schoolId, classId, dayOfWeek, periodLabel])
}

model TeacherAssignment {
  id         String    @id @default(cuid())
  schoolId   String
  teacherId  String
  classId    String
  subject    Subject
  isPrimary  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  school     School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher    User      @relation("TeacherAssignmentTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  class      Class     @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([schoolId, teacherId, classId, subject])
  @@index([schoolId, teacherId])
  @@index([schoolId, classId])
}

/// / ===== Student Progress =====
model StudentProgress {

  @@index([teacherId, createdAt])
}

model CurriculumFlag {
  id               String    @id @default(cuid())
  lessonId         String?
  schoolId         String?
  flagType         String    @default("FLAG_CURRICULUM_REVIEW")
  sourceSignal     String

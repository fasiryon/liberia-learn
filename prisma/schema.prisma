  @@index([studentId, createdAt])
  @@index([categoryId, createdAt])
  @@index([assessmentAttemptId, createdAt])
  @@index([chainId, createdAt])
}

/// Sprint 2: normalized AI interaction provenance.
/// Complements the aggregate AiInteractionLog table.
model AIInteraction {
  id                 String    @id @default(cuid())
  schoolId           String?
  userId             String?
  studentId          String?
  route              String?
  feature            String?
  requestType        String?
  guidanceLevel      String?
  subject            String?
  strandKey          String?
  contentId          String?
  lessonId           String?
  provider           String?
  model              String?
  tier               String?

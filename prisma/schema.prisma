/// / ===== Scheduled Work (Today's Work) =====
model ScheduledWork {
  id             String            @id @default(cuid())
  contentId      String
  classId        String
  scheduledDate  DateTime
  createdById    String
  createdAt      DateTime          @default(now())
  endTime        String?
  periodNumber   Int?
  startTime      String?
  // Part 2: scheduling + delivery tracking fields
  classFormat    String?           // "standard"|"block_a"|"block_b"|"block_single"
  deliveredAt    DateTime?
  deliveryNotes  String?
  completionRate Int?              // 0-100
  isDelivered    Boolean           @default(false)
  // Part 3: A/B block pairing
  sessionPairId  String?           // shared UUID for A/B pairs
  status         String?           // "confirmed"|"suggested"|"dismissed"
  // Part 7: virtual labs
  suggestedLabs  Json?             // auto-populated matched labs
  // Part 6: toolkit
  toolUsageLog   Json?             // toolKeys opened during session
  class          Class             @relation(fields: [classId], references: [id])
  content        CurriculumContent @relation(fields: [contentId], references: [contentId])
  progress       StudentProgress[]

  @@index([classId, scheduledDate])
  @@index([contentId])
  @@index([sessionPairId])
}

model Timetable {
  id         String     @id @default(cuid())
  schoolId   String
  classId    String
  subject    Subject
  teacherId  String
  dayOfWeek  Weekday
  periodLabel String
  startTime  String?
  endTime    String?
  room       String?

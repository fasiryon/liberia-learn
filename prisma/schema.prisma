  @@index([moduleId, status])
  @@index([teacherUserId, status])
}

/// Aggregate AI interaction log. No studentId  no PII.
/// One row per AI call (tutor or teacher assist).
/// Used for: cost tracking, fallback rate, correlation with mastery.
model AiInteractionLog {
  id               String   @id @default(cuid())
  /// School that the call originated from (null = national/unknown)
  schoolId         String?
  userId           String?
  feature          String?
  subject          String
  strandKey        String
  /// "explain" | "practice" | "step_by_step" | "reinforce" | "teacher_assist"
  requestType      String
  endpoint         String?
  /// "light" | "moderate" | "intensive" | null (teacher_assist)
  guidanceLevel    String?
  model            String?
  tier             String?
  hadFallback      Boolean  @default(false)
  tokensUsed       Int      @default(0)
  estimatedCostUSD Float    @default(0)
  timestamp        DateTime @default(now())

  @@index([timestamp])
  @@index([subject, strandKey])
  @@index([schoolId, timestamp])
  @@index([feature, timestamp])
  @@index([userId, timestamp])
}

/// / ===== Block 12A: Impact Snapshots =====

/// Persisted rollup of impact computation results for a tenant/period.
/// Append-only  each computation stores a new row if ENABLE_IMPACT_SNAPSHOTS=true.
/// No student identifiers  aggregates only.
/// Query the latest row per (tenantId, schoolId, classId, period) for dashboards.
model ImpactSnapshot {
  id                      String   @id @default(cuid())
  /// School that owns this snapshot (tenant boundary).
  tenantId                String
  /// NULL when snapshot covers the full school.
  schoolId                String?
  /// NULL when snapshot is school-scoped (not class-scoped).
  classId                 String?
  /// YYYY-MM format  corresponds to the `to` bound of the periodRange.
  period                  String
  proficiencyRate         Float
  avgMasteryScore         Float
  masteryDelta            Float
  growthDelta             Float
  /// Cohen's d effect size. NULL when insufficient data.
  effectSize              Float?
  statisticallyMeaningful Boolean
  /// "low" | "medium" | "high"
  confidenceLabel         String
  sampleSize              Int      @default(0)
  generatedAt             DateTime @default(now())

  @@index([tenantId, period])
  @@index([schoolId, period])
  @@index([classId, period])
  @@index([generatedAt])
}

/// / ===== Block 15: Longitudinal Growth Snapshots =====
///
/// Monthly per-student mastery snapshots used for teacher class views and
/// admin aggregate growth summaries.
/// No PII fields are stored in this table.
model LongitudinalSnapshot {
  id             String   @id @default(cuid())
  tenantId       String
  schoolId       String
  studentId      String
  subject        Subject
  strandKey      String?
  periodStart    DateTime
  periodType     String   @default("monthly")
  score          Float
  growthRate     Float    @default(0)
  classification String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId, schoolId, periodStart])
  @@index([schoolId, studentId, periodStart])
  @@index([subject, strandKey, periodStart])
  @@index([classification, periodStart])
}

model InterventionLog {
  id                        String    @id @default(cuid())
  tenantId                  String
  schoolId                  String
  districtId                String?
  interventionPriorityScore Float
  growthRiskFlag            String
  recommendedActionCount    Int
  aiEnhanced                Boolean   @default(false)
  generatedAt               DateTime  @default(now())
  outcomeCheckedAt          DateTime?
  outcomeDelta              Float?
  outcomeEffectSize         Float?
  outcomeBaselineStart      DateTime?
  outcomeBaselineEnd        DateTime?
  outcomeFollowupStart      DateTime?
  outcomeFollowupEnd        DateTime?
  outcomeBaselineCount      Int?
  outcomeFollowupCount      Int?
  school                    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  district                  District? @relation(fields: [districtId], references: [id])

  @@index([tenantId, generatedAt])
  @@index([schoolId, generatedAt])
  @@index([districtId, generatedAt])
}

/// / ===== Integrated Delivery Engine Models (Parts 4, 5, 7) =====

/// Part 4: Curriculum Unit grouping — organises CurriculumContent into teaching units
model CurriculumUnit {
  id                  String   @id @default(cuid())
  unitId              String   @unique @default(cuid())
  name                String
  description         String?
  subject             String
  grade               Int
  schoolId            String
  targetStandardCodes String[]
  weekStart           Int
  weekEnd             Int
  createdById         String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  school              School   @relation(fields: [schoolId], references: [id])
  createdBy           User     @relation("CurriculumUnitCreatedBy", fields: [createdById], references: [id])

  @@index([schoolId, grade, subject])
}

/// Part 5: Auto-generated assignment suggestions linked to scheduled lessons
model AssignmentSuggestion {
  id               String   @id @default(cuid())
  schoolId         String
  contentId        String
  scheduledWorkId  String
  classId          String
  suggestedTitle   String
  suggestedDueDate DateTime
  moeStandardCodes String[]
  status           String   @default("pending") // "pending"|"accepted"|"dismissed"
  createdAt        DateTime @default(now())

  school           School   @relation(fields: [schoolId], references: [id])

  @@index([schoolId, status])
  @@index([scheduledWorkId])
}

/// Part 7: Virtual lab definitions (platform-wide or school-specific)
model VirtualLab {
  id                   String   @id @default(cuid())
  labId                String   @unique @default(cuid())
  title                String
  description          String
  subject              String
  grade                Int
  gradeBand            String
  labType              String   // "2d_simulation"|"3d_environment"|"guided_walkthrough"
  moeStandardCodes     String[]
  primaryContentIds    String[]
  triggerStandardCodes String[]
  estimatedMinutes     Int
  difficulty           String   // "introductory"|"standard"|"advanced"
  equipmentList        String[]
  safetyNotes          String?
  payload              Json     // lab definition: steps, interactions
  status               String   @default("draft")
  schoolId             String?  // null = platform-wide

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([subject, grade, status])
  @@index([schoolId])
}

/// Part 7: Student lab session records
model LabSession {
  id               String    @id @default(cuid())
  labId            String
  studentId        String
  scheduledWorkId  String?
  schoolId         String
  startedAt        DateTime  @default(now())
  completedAt      DateTime?
  observations     Json?
  conclusions      String?
  score            Int?
  aiAnalysis       Json?
  teacherFeedback  String?
  masteryUpdated   Boolean   @default(false)
  createdAt        DateTime  @default(now())

  school           School    @relation(fields: [schoolId], references: [id])
  student          User      @relation("LabSessionStudent", fields: [studentId], references: [id])

  @@index([schoolId, labId])
  @@index([scheduledWorkId])
  @@index([studentId, schoolId])
}

/// / ===== Guardian Messaging =====

/// Direct messages between a guardian and a teacher about a specific student.
/// Tenant-scoped via schoolId. fromRole distinguishes sender direction.
model GuardianMessage {
  id         String   @id @default(cuid())
  guardianId String
  teacherId  String
  studentId  String
  schoolId   String
  fromRole   String   // "guardian" | "teacher"
  body       String
  sentAt     DateTime @default(now())
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  guardian User    @relation("GuardianMessageGuardian", fields: [guardianId], references: [id])
  teacher  User    @relation("GuardianMessageTeacher", fields: [teacherId], references: [id])
  student  Student @relation(fields: [studentId], references: [id])
  school   School  @relation(fields: [schoolId], references: [id])

  @@index([guardianId, sentAt])
  @@index([teacherId, sentAt])
  @@index([studentId])
  @@index([schoolId])
}


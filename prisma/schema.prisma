  videoSupplements LessonVideo[]
  embeddedAt      DateTime?
  embedding       Unsupported("vector(1536)")?
  curriculumVersion CurriculumVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)

  @@index([grade, subject])
  @@index([contentType, status])
  @@index([unitId, orderInUnit])
  @@index([versionId, status])
}


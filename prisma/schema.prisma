  token           String    @unique @default(cuid())
  tokenHash       String?
  createdBy       String
  intendedUserId  String?
  expiresAt       DateTime
  usedAt          DateTime?
  usedBy          String?
  createdAt       DateTime  @default(now())
}

model PilotChecklistItem {
  id                   String                 @id
  title                String
  description          String?
  sortOrder            Int                    @default(0)

  schoolId                  String?
  districtId                String?
  studentId                 String?
  teacherUserId             String?
  openedByUserId            String?
  openedByRole              String?
  attributionSource         String?
  status                    String   @default("open")
  currentStage              String   @default("baseline")
  rationale                 String?
  sourceAssessmentAttemptId String?
  baselineSnapshotId        String?
  latestInterventionId      String?
  metadata                  Json?
  openedAt                  DateTime @default(now())
  interventionStartedAt     DateTime?
  outcomeMeasuredAt         DateTime?
  retentionCheckedAt        DateTime?
  closedAt                  DateTime?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@index([studentId, status, openedAt])
  @@index([schoolId, status, currentStage, openedAt])
  @@index([teacherUserId, status, openedAt])
  @@index([sourceAssessmentAttemptId])
}

/// Sprint 3: extensible misconception taxonomy for system and teacher workflows.
model MisconceptionCategory {
  id              String   @id @default(cuid())
  schoolId        String?
  subject         String?
  strandKey       String?
  code            String
  label           String
  description     String?
  severity        String?
  examples        Json?
  guidance        Json?
  createdByUserId String?
  isSystem        Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([schoolId, code], name: "MisconceptionCategory_schoolId_code_key")
  @@index([subject, strandKey, isActive])
  @@index([createdByUserId, createdAt])
}

/// Sprint 3: append-only misconception tags attached to attempts, interventions, and chains.
model MisconceptionTag {
  id                  String   @id @default(cuid())
  studentId           String
  schoolId            String?
  assessmentAttemptId String?
  interventionId      String?
  chainId             String?
  categoryId          String

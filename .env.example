# LiberiaLearn environment example
# Copy to .env.local for local development. Never commit real secrets.
# Full reference: docs/rollout/ENV_VARS.md

# Core app
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# Auth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# AI providers
OPENAI_API_KEY=""
GROQ_API_KEY=""
AI_BUDGET_MONTHLY_CAP_USD="100"

# Observability
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# Distributed rate limiting
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Media storage
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_LESSON_AUDIO_BUCKET="lesson-audio"
ENABLE_LESSON_AUDIO_GENERATION="false"
TTS_DAILY_BUDGET_USD="5"
TTS_MONTHLY_CAP_USD="100"
TTS_STOP_GENERATION="false"
ENABLE_COST_DASHBOARD="true"

# Cron job authentication
CRON_SECRET="generate-with-openssl-rand-base64-32"

# SMS / notifications
RESEND_API_KEY=""
EMAIL_FROM="LiberiaLearn <noreply@liberialearn.edu.lr>"
# Backward-compatible alias still accepted at runtime:
RESEND_FROM_EMAIL=""
AT_API_KEY=""
AT_USERNAME=""
AT_ENVIRONMENT="sandbox"
AT_SENDER_ID=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Optional demo / dev
LOG_LEVEL="info"
DEMO_MODE="false"
DEMO_RESET_SECRET="change-me-before-demo"
DEMO_SCHOOL_IDS=""
DEMO_SEED_PASSWORD=""
TEST_DEMO_PASSWORD=""
ALLOW_LIVE_DEMO_RESET="false"
E2E_DEMO_STUDENT_EMAIL=""
E2E_DEMO_STUDENT_PASSWORD=""

# Server-side feature flags
OPS_AI_EXPLANATIONS_ENABLED="false"
OPS_AI_MIN_SEVERITY="warn"

ENABLE_GOV_EXPORTS="true"
ENABLE_GOV_STUDENT_PII_EXPORT="false"
ENABLE_GOV_NATIONAL_EXPORT="true"
ENABLE_GOV_AUDIT_SEARCH="true"
ENABLE_GOV_CIRCUIT_BREAKER="false"

AI_TUTOR_ENABLED="false"
AI_TEACHER_ASSIST_ENABLED="false"
AI_TUTOR_DAILY_LIMIT="20"
AI_TEACHER_ASSIST_DAILY_LIMIT="50"
ENABLE_RAG_TUTOR="false"
ENABLE_TEACHER_GENERATION="false"
ENABLE_EVAL_DB_LOGGING="false"

ENABLE_IMPACT_ANALYTICS="false"
ENABLE_IMPACT_SNAPSHOTS="false"
ENABLE_ASSIGNMENT_TUTOR="false"
ENABLE_AI_GRADING_ASSIST="false"
ENABLE_INTERVENTION_ALERTS="false"
ENABLE_AI_INTERVENTIONS="false"
ENABLE_INTERVENTION_OUTCOMES="false"
AI_INTERVENTIONS_AI_ENHANCED="false"
ENABLE_DISTRICT_INTELLIGENCE="false"
ENABLE_CONFUSION_DETECTION="false"
ENABLE_INTERVENTION_ENGINE="true"

ENABLE_CLASSROOM_TOOLKIT="false"
ENABLE_TOOLKIT_CALCULATOR="false"
ENABLE_TOOLKIT_SCIENCE_TOOLS="false"
ENABLE_TOOLKIT_GEO_TOOLS="false"
ENABLE_TOOLKIT_TIMER="false"
ENABLE_LONGITUDINAL_TRACKING="false"

ENABLE_DROPOUT_RISK="false"
AI_DROPOUT_RISK_ENABLED="false"
ENABLE_CURRICULUM_OPTIMIZATION="false"
ENABLE_CURRICULUM_OPTIMIZATION_AI="false"

ENABLE_GEO_INTELLIGENCE="false"
ENABLE_NATIONAL_INSIGHTS="false"

ENABLE_MOE_PORTAL="false"
ENABLE_MOE_LOGIN_PORTAL="false"
MOE_PORTAL_ALLOWLIST=""

ENABLE_ENROLLMENT_INVITES="false"
ENABLE_ACCOUNT_RECOVERY="false"
ENABLE_GUARDIAN_PORTAL="true"
ENABLE_GUARDIAN_LINKING="true"
ENABLE_GUARDIAN_DASHBOARD="true"

ENABLE_CURRICULUM_FEEDBACK="false"

ENABLE_DELIVERY_PROFILE="false"
ENABLE_LESSON_DELIVERY_TRACKING="false"
ENABLE_AB_BLOCK_SCHEDULING="false"
ENABLE_UNIT_GROUPING="false"
ENABLE_UNIT_ASSEMBLY="false"
ENABLE_TEXTBOOK_COMPILER="true"
ENABLE_AI_LABS="false"
AI_LABS_DAILY_BUDGET_USD="5"
ENABLE_ASSIGNMENT_LESSON_LINKAGE="false"
ENABLE_AI_ASSIGNMENT_GENERATION="true"
ENABLE_TOOLKIT_LESSON_INTEGRATION="false"
ENABLE_VIRTUAL_LABS="false"
ENABLE_DELIVERY_COMPLIANCE_REPORTING="false"

ENABLE_ADAPTIVE_ENGINE="true"
ENABLE_EXAM_SYSTEM="true"
ENABLE_INTERVENTION_WORKFLOW="true"
ENABLE_PERFORMANCE_EVENTS="true"
ENABLE_PILOT_READINESS="true"
ENABLE_PROMPT_REGISTRY="true"
ENABLE_AUDIT_IMMUTABILITY="true"
ENABLE_TEACHER_INTELLIGENCE_DASHBOARD="true"
ENABLE_GUARDIAN_PROGRESS_VIEW="true"
ENABLE_PILOT_READINESS_DASHBOARD="true"

# Client-side feature flags
NEXT_PUBLIC_ENABLE_GUIDED_ONBOARDING="false"
NEXT_PUBLIC_ENABLE_ACCESSIBILITY_MODE="false"
NEXT_PUBLIC_ENABLE_GUARDIAN_PORTAL="true"
NEXT_PUBLIC_ENABLE_ENROLLMENT_INVITES="false"
NEXT_PUBLIC_ENABLE_ACCOUNT_RECOVERY="false"
NEXT_PUBLIC_ENABLE_TRAINING_CENTER="false"
NEXT_PUBLIC_ENABLE_MASTERY_ENGINE="false"
NEXT_PUBLIC_ENABLE_AI_TUTOR="false"
NEXT_PUBLIC_ENABLE_RAG_TUTOR="false"

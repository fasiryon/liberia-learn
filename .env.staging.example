# Non-secret identity. This must never equal the production project reference.
STAGING_SUPABASE_PROJECT_REF=replace-with-dedicated-staging-project-ref
P2A_STAGING_PROJECT_REF=replace-with-dedicated-staging-project-ref

# Runtime-only, server-only, secret. Supavisor transaction mode, port 6543.
DATABASE_URL=postgresql://postgres.STAGING_REF:STAGING_PASSWORD@aws-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&pool_timeout=20&sslmode=require

# Migration-only, operator-only secrets. Prefer the direct endpoint on port
# 5432. When it is IPv6-only and unreachable, use the Supavisor session-mode
# pooler on port 5432 with username postgres.STAGING_REF. Never use port 6543.
DIRECT_URL=postgresql://postgres:STAGING_PASSWORD@db.STAGING_REF.supabase.co:5432/postgres?sslmode=require
P2A_STAGING_DATABASE_URL=postgresql://postgres:STAGING_PASSWORD@db.STAGING_REF.supabase.co:5432/postgres?sslmode=require
P2A_DIRECT_ENDPOINT_UNREACHABLE=false

# Supabase API and storage identity.
SUPABASE_URL=https://STAGING_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-staging-service-role-key
SUPABASE_ANON_KEY=replace-with-staging-anon-key
NEXT_PUBLIC_SUPABASE_URL=https://STAGING_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-staging-anon-key

# Stable staging application and Gate 0 evidence paths.
P2A_STAGING_APP_URL=https://replace-with-stable-staging-host
P2A_STAGING_DEPLOYMENT_ENV_FILE=.vercel/.env.staging.local
P2A_BACKUP_EVIDENCE_PATH=artifacts/p2a-staging/backup-evidence.json
P2A_PROVENANCE_WRITERS_DISABLED=true

# Staging must use independent auth and provider credentials or disabled features.
NEXTAUTH_URL=https://replace-with-stable-staging-host
NEXTAUTH_SECRET=replace-with-staging-only-secret
DEMO_MODE=false
ENABLE_LESSON_AUDIO_GENERATION=false
ENABLE_CURRICULUM_REGEN_QUEUE=false
ENABLE_SMS=false

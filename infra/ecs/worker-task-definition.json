{
  "family": "liberia-learn-worker",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::466568847266:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::466568847266:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "worker",
      "image": "466568847266.dkr.ecr.us-east-1.amazonaws.com/liberialearn-worker:latest",
      "essential": true,
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "AWS_REGION", "value": "us-east-1" },
        { "name": "AWS_DEFAULT_REGION", "value": "us-east-1" }
      ],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:ssm:us-east-1:466568847266:parameter/liberialearn/DATABASE_URL"
        },
        {
          "name": "DIRECT_URL",
          "valueFrom": "arn:aws:ssm:us-east-1:466568847266:parameter/liberialearn/DIRECT_URL"
        },
        {
          "name": "SQS_QUEUE_URL",
          "valueFrom": "arn:aws:ssm:us-east-1:466568847266:parameter/liberialearn/SQS_QUEUE_URL"
        },
        {
          "name": "SQS_DLQ_URL",
          "valueFrom": "arn:aws:ssm:us-east-1:466568847266:parameter/liberialearn/SQS_DLQ_URL"
        },
        {
          "name": "OPENAI_API_KEY",
          "valueFrom": "arn:aws:ssm:us-east-1:466568847266:parameter/liberialearn/OPENAI_API_KEY"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/liberia-learn-worker",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "worker",
          "awslogs-create-group": "true"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "node -e \"console.log('ok')\" || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3
      }
    }
  ]
}

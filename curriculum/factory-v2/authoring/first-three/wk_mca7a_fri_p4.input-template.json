      }
    ],
    "objectives": [
      {
        "id": "ft01-o1",
        "kind": "NATIONAL",
        "statement": "Locate each of Liberia's 15 counties on an outline map and name its capital.",
        "sourceId": "first-ten-cohort-contract",
        "sourcePointer": "/lessons/0/objectives/0",
        "scope": "REQUIRED",
        "mapping": "PROPOSED"
      },
      {
        "id": "ft01-o2",
        "kind": "LIBERIALEARN_MASTERY",
        "statement": "Explain the difference between a county capital (the seat of county administration) and a county's largest or best-known town, and between the national capital and a county capital, using Nimba (Sanniquellie/Ganta) and Montserrado as examples.",
        "sourceId": "first-ten-cohort-contract",
        "sourcePointer": "/lessons/0/objectives/1",
        "scope": "REQUIRED",
        "mapping": "PROPOSED"
      },
      {
        "id": "ft01-o3",
        "kind": "GLOBAL_EXCELLENCE",
        "statement": "Use a county map to reason about location: name the counties crossed, and the capitals passed, on a route between two county capitals, and justify the answer from the map.",
        "sourceId": "first-ten-cohort-contract",
        "sourcePointer": "/lessons/0/objectives/2",
        "scope": "REQUIRED",
        "mapping": "PROPOSED"
      }
    ],
    "outcomes": [
      {
        "id": "ft01-o1-outcome",
        "objectiveIds": [
          "ft01-o1"
        ],
        "demonstration": "Locate each of Liberia's 15 counties on an outline map and name its capital."
      },
      {
        "id": "ft01-o2-outcome",
        "objectiveIds": [
          "ft01-o2"
        ],
        "demonstration": "Explain the difference between a county capital (the seat of county administration) and a county's largest or best-known town, and between the national capital and a county capital, using Nimba (Sanniquellie/Ganta) and Montserrado as examples."
      },
      {
        "id": "ft01-o3-outcome",
        "objectiveIds": [
          "ft01-o3"
        ],
        "demonstration": "Use a county map to reason about location: name the counties crossed, and the capitals passed, on a route between two county capitals, and justify the answer from the map."
      }
    ],
    "prerequisites": [
      {
        "id": "ft01-p1",
        "statement": "Reads compass directions and a map key.",
        "diagnosticResourceId": "diagnostic",

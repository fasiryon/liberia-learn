    "objectives": [
      {
        "id": "ft04-o1",
        "kind": "NATIONAL",
        "statement": "Use the particle model to describe and compare solids, liquids and gases (arrangement, movement, shape and volume), with Liberian examples.",
        "sourceId": "first-ten-cohort-contract",
        "sourcePointer": "/lessons/3/objectives/0",
        "scope": "REQUIRED",
        "mapping": "PROPOSED"
      },
      {
        "id": "ft04-o2",
        "kind": "NATIONAL",
        "statement": "Explain melting, freezing, evaporation, boiling and condensation as energy gained or lost by particles, and distinguish evaporation from boiling.",
        "sourceId": "first-ten-cohort-contract",
        "sourcePointer": "/lessons/3/objectives/1",
        "scope": "REQUIRED",
        "mapping": "PROPOSED"
      },
      {
        "id": "ft04-o3",
        "kind": "LIBERIALEARN_MASTERY",
        "statement": "Predict and explain, with evidence, what happens to temperature when ice melts in a drink (it stays at about 0 °C while ice remains), and recognise changes of state as reversible physical changes.",
        "sourceId": "first-ten-cohort-contract",
        "sourcePointer": "/lessons/3/objectives/2",
        "scope": "REQUIRED",
        "mapping": "PROPOSED"
      }
    ],
    "outcomes": [
      {
        "id": "ft04-o1-outcome",
        "objectiveIds": [
          "ft04-o1"
        ],
        "demonstration": "Use the particle model to describe and compare solids, liquids and gases (arrangement, movement, shape and volume), with Liberian examples."
      },
      {
        "id": "ft04-o2-outcome",
        "objectiveIds": [
          "ft04-o2"
        ],
        "demonstration": "Explain melting, freezing, evaporation, boiling and condensation as energy gained or lost by particles, and distinguish evaporation from boiling."
      },
      {
        "id": "ft04-o3-outcome",
        "objectiveIds": [
          "ft04-o3"
        ],
        "demonstration": "Predict and explain, with evidence, what happens to temperature when ice melts in a drink (it stays at about 0 °C while ice remains), and recognise changes of state as reversible physical changes."
      }
    ],

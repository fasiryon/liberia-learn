    "objectives": [
      {
        "id": "ft07-o1",
        "kind": "NATIONAL",
        "statement": "Represent fractions, including fractions equal to or greater than 1, on area models and a number line, naming the whole each fraction refers to.",
        "sourceId": "first-ten-cohort-contract",
        "sourcePointer": "/lessons/6/objectives/0",
        "scope": "REQUIRED",
        "mapping": "PROPOSED"
      },
      {
        "id": "ft07-o2",
        "kind": "NATIONAL",
        "statement": "Add and subtract fractions with like denominators, and with related denominators (e.g. halves, quarters, eighths), by using equivalent fractions.",
        "sourceId": "first-ten-cohort-contract",
        "sourcePointer": "/lessons/6/objectives/1",
        "scope": "REQUIRED",
        "mapping": "PROPOSED"
      },
      {
        "id": "ft07-o3",
        "kind": "LIBERIALEARN_MASTERY",
        "statement": "Compare and order fractions using benchmarks (0, 1/2, 1), common denominators and the number line, and justify each comparison.",
        "sourceId": "first-ten-cohort-contract",
        "sourcePointer": "/lessons/6/objectives/2",
        "scope": "REQUIRED",
        "mapping": "PROPOSED"
      }
    ],

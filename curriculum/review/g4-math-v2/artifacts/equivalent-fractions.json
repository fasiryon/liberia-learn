    {
      "id": "rule",
      "type": "EXPLANATION",
      "title": "The multiplying rule",
      "purpose": "EXPLAIN_CONCEPT",
      "objectiveIds": [
        "moe-math-g4-s1-p3-number-theory-and-fraction-obj5"
      ],
      "learnerAction": "Read the rule and the example.",
      "content": {
        "body": "Each fold doubled the number of parts and doubled the shaded parts. That is the rule: **multiply the top and the bottom by the same number** and the amount stays the same.\n\n1/2 = (1 × 3)/(2 × 3) = 3/6.\n\nAdding the same number does not work: 1/2 is not 2/3.",
        "keyPoints": [
          "Multiply top and bottom by the same number.",
          "Never add the same number to top and bottom."
        ]
      },
      "interaction": {
        "kind": "NONE"
      },
      "tools": {
        "requested": [],
        "prohibited": []
      },
      "hints": [],
      "misconceptionIds": [
        "adds-same-number"
      ],
      "evidence": {
        "kind": "NONE"
      },
      "accessibility": {
        "textAlternative": "Multiply the numerator and the denominator by the same number to get an equivalent fraction: 1/2 times 3 over 3 is 3/6. Adding does not work.",
        "keyboardPath": "Read the text, then Continue.",
        "reducedMotion": "NOT_APPLICABLE"
      },
      "offline": {
        "mode": "FULL_OFFLINE",
        "note": "Text only."
      },
      "completion": "VIEWED",
      "pedagogy": {
        "strategy": "CONCRETE_PICTORIAL_ABSTRACT",
        "representation": "ABSTRACT",
        "scaffoldLevel": "PARTIAL"

{
  "_about": "Reviewer recommendations for the Grade 4 Math founder review. These are NOT founder decisions and NOT MOE approval: decisions live only in review-ledger.json and are made by the founder. Each recommendation pins the payload sha256 it was assessed against; scripts/build-g4-math-review-package.ts fails if the content changes without re-assessment.",
  "review": {
    "id": "CPR-2026-09-26",
    "date": "2026-09-26",
    "isFounderApproval": false,
    "isMoeApproval": false,
    "summary": "A substantive curriculum/product review (CPR-2026-09-26) required 16 content revisions and adopted 5 policies. The revisions are applied in the lessons and the cell; each objective was then re-assessed against the quality bar (MOE scope, mathematics, answers and distractors, Grade 4 difficulty, component alignment, meaningful interaction, credible offline implementation, context, labeled example data, honest provenance, no MOE-approval claim, no unavailable capability presented as implemented)."
  },
  "recommendedBy": "LiberiaLearn curriculum revision pass (AI-assisted), applying CPR-2026-09-26; not a founder decision",
  "values": {
    "READY_FOR_FOUNDER_APPROVAL": "Meets every point of the quality bar; ready for the founder's own review and ledger decision.",
    "REVISE": "A content change is still needed before founder approval (the note says what).",
    "BLOCKED_SOURCE": "MOE scope cannot be confirmed from the source evidence available.",
    "BLOCKED_POLICY": "Needs a founder policy decision before the content can be judged."
  },
  "decisions": {
    "CPR-2026-09-26-P1": {
      "kind": "POLICY",
      "title": "Example data",
      "text": "Clearly labeled example data is acceptable for instructional arithmetic. Real authoritative data may be added where the learning goal requires interpreting real national data; it is not mandatory for basic operations."
    },
    "CPR-2026-09-26-P2": {
      "kind": "POLICY",
      "title": "Squared paper",
      "text": "Squared paper is an acceptable required/core modality for Grade 4 area and perimeter today. A digital grid is an enhancement (GRADE_4_6_GRID_MANIPULATIVE) and does not block lesson approval."
    },
    "CPR-2026-09-26-P3": {
      "kind": "POLICY",
      "title": "Solids",
      "text": "Real physical solids are the current required modality. 3D solids are a planned enhanced digital modality; no 3D runtime exists and none is presented as implemented."
    },
    "CPR-2026-09-26-P4": {
      "kind": "POLICY",
      "title": "Intersecting lines",
      "text": "MOE 'interesting lines' is interpreted by LiberiaLearn as 'intersecting lines'; the MOE text is preserved in provenance."
    },
    "CPR-2026-09-26-P5": {
      "kind": "POLICY",
      "title": "Mass",
      "text": "Use 'mass' pedagogically; preserve MOE 'weight' wording where it is quoted."
    },
    "CPR-2026-09-26-R01": {
      "kind": "REVISION",
      "objective": "1.1",
      "title": "Place-value manipulative",
      "text": "Reclassify NONE -> MANIPULATIVE_2D with a place-value chart and strips; keep the offline paper implementation."
    },
    "CPR-2026-09-26-R02": {
      "kind": "REVISION",
      "objective": "1.4",
      "title": "Estimate",
      "text": "Replace the loose estimate with 48,000 + 1,400 - 400 = 49,000; keep population figures labeled as example data; no external census data."
    },
    "CPR-2026-09-26-R03": {
      "kind": "REVISION",
      "objective": "2.3",
      "title": "Area model",
      "text": "Reclassify NONE -> MANIPULATIVE_2D using the area-model / graph-paper activity."
    },
    "CPR-2026-09-26-R04": {
      "kind": "REVISION",
      "objective": "3.2",
      "title": "Prime factors",
      "text": "Add factor-tree instruction (12 = 2 x 2 x 3, 30 = 2 x 3 x 5) with aligned practice and checks in 3.2; keep 3.3 LCM/GCF listing-based."
    },
    "CPR-2026-09-26-R05": {
      "kind": "REVISION",
      "objective": "3.4",
      "title": "Fractions exemplar 2026.2",
      "text": "Teach whole and set from the opening; make 'Find parts of a set' explicit throughout; exit evidence assesses part of a set; bottle caps/stones required offline; record SET_FRACTION_MANIPULATIVE_REQUIRED; move fractions greater than one to an optional extension. 2026.1 unchanged."
    },
    "CPR-2026-09-26-R06": {
      "kind": "REVISION",
      "objective": "3.7",
      "title": "Add like denominators",
      "text": "Restrict to like denominators with the documented replacements; remove related/unlike denominators; correct the provenance wording so LiberiaLearn examples are not attributed to MOE."
    },
    "CPR-2026-09-26-R07": {
      "kind": "REVISION",
      "objective": "3.8",
      "title": "Subtract like denominators",
      "text": "Restrict to like denominators and taking from a whole with the documented replacements; remove the 4/0 distractor."
    },
    "CPR-2026-09-26-R08": {
      "kind": "REVISION",
      "objective": "5.5",
      "title": "Mass and benchmarks",
      "text": "Open with 'Mass tells how heavy something is. People often call it weight.'; use 'mass' after that; replace inconsistent sugar-bag benchmarks with unambiguous (label-based) benchmarks."
    },
    "CPR-2026-09-26-R09": {
      "kind": "REVISION",
      "objective": "5.8",
      "title": "Distractors",
      "text": "Replace the malformed distractors '3 m 120 cm only' and '2,1000 g' with valid, plausible ones."
    },
    "CPR-2026-09-26-R10": {
      "kind": "REVISION",
      "objective": "5.9",
      "title": "Grid gap",
      "text": "Keep MANIPULATIVE_2D on squared paper; record GRADE_4_6_GRID_MANIPULATIVE; do not block approval on the digital tool."
    },
    "CPR-2026-09-26-R11": {
      "kind": "REVISION",
      "objective": "6.1",
      "title": "Provenance note",
      "text": "Keep the raw MOE objective; add the teacher/provenance note on 'interesting lines' -> 'intersecting lines'."
    },
    "CPR-2026-09-26-R12": {
      "kind": "REVISION",
      "objective": "6.3",
      "title": "Polygon manipulative",
      "text": "Reclassify NONE -> MANIPULATIVE_2D with polygon cut-outs, sticks and sorting."
    },
    "CPR-2026-09-26-R13": {
      "kind": "REVISION",
      "objective": "6.4",
      "title": "Circle manipulative",
      "text": "Reclassify NONE -> MANIPULATIVE_2D with tracing, folding and handling paper circles."
    },
    "CPR-2026-09-26-R14": {
      "kind": "REVISION",
      "objective": "6.5",
      "title": "Solid models",
      "text": "No funnel as the canonical cone or open cup as the canonical cylinder; use a paper cone hat, closed tin, ball, die/cube, box/brick. Execution PRACTICAL; planned THREE_D (rotation, hidden-face inspection) augments real objects and is not implemented."
    },
    "CPR-2026-09-26-R15": {
      "kind": "REVISION",
      "objective": "6.6",
      "title": "Family-size data and mode",
      "text": "Voluntary, anonymous family-size data per MOE; teach and assess reading the mode from the graph (practice + quiz); keep mean/median calculation in 6.7; reclassify NONE -> PRACTICAL with teacher-observed evidence, governed item responses planned."
    },
    "CPR-2026-09-26-R16": {
      "kind": "REVISION",
      "objective": "6.7",
      "title": "Median note",
      "text": "Keep 'median'; preserve raw MOE 'medium' in provenance; add a note that LiberiaLearn interprets 'medium' as 'median' because surrounding MOE materials corroborate it; do not claim the source text was corrected."
    }
  },

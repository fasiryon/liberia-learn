  "objectives": [
    {
      "id": "ft01-o1",
      "kind": "LIBERIALEARN_MASTERY",
      "statement": "Identify Liberia's fifteen county-capital pairs in a name register, without inferring geographic locations from entry order.",
      "sourceId": "v4-reference-inputs",
      "sourcePointer": "moe-social-studies-g7-s1-p1-the-earth-and-the-solar-system-semester-one-act6",
      "scope": "REQUIRED",
      "mapping": "PROPOSED"
    },
    {
      "id": "ft01-o2",
      "kind": "LIBERIALEARN_MASTERY",
      "statement": "Distinguish county capitals from well-known cities and the national capital using Nimba and Montserrado as examples.",
      "sourceId": "v4-reference-inputs",
      "sourcePointer": "moe-social-studies-g7-s1-p1-the-earth-and-the-solar-system-semester-one-act6",
      "scope": "REQUIRED",
      "mapping": "PROPOSED"
    },
    {
      "id": "ft01-o3",
      "kind": "LIBERIALEARN_MASTERY",
      "statement": "Explain which administrative claims a county-capital register supports and request geographic and road sources for route planning.",
      "sourceId": "v4-reference-inputs",
      "sourcePointer": "moe-social-studies-g7-s1-p1-the-earth-and-the-solar-system-semester-one-act6",
      "scope": "REQUIRED",
      "mapping": "PROPOSED"
    }

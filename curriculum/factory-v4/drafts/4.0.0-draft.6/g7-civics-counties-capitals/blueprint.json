      "sourcePointer": "moe-social-studies-g7-s1-p1-the-earth-and-the-solar-system-semester-one-act6",
      "scope": "REQUIRED",
      "mapping": "PROPOSED"
    },
    {
      "id": "ft01-o2",
      "kind": "LIBERIALEARN_MASTERY",
      "statement": "Distinguish county capitals from the national capital and well-known towns, using Montserrado and Nimba.",
      "sourceId": "v4-reference-inputs",
      "sourcePointer": "moe-social-studies-g7-s1-p1-the-earth-and-the-solar-system-semester-one-act6",
      "scope": "REQUIRED",
      "mapping": "PROPOSED"
    },
    {
      "id": "ft01-o3",
      "kind": "LIBERIALEARN_MASTERY",
      "statement": "Use the supplied geographic map to compare north-south position and coastal location, while distinguishing these from unverified road routes.",

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ignore nested node_modules
**/node_modules/

# --- local/dev artifacts ---
_patches/
LL_AUDIT_DUMP*
*.bak.*
# --- optional: logs/temp ---
*.log

_frontend_old
_frontend_old/**
_app_backup_*
LL_AUDIT_DUMP*.txt


app.BACKUP-*
app.BACKUP-*/**
lib.BACKUP-*
lib.BACKUP-*/**
**/*.BACKUP-*


_ARCHIVE_*/**


_ARCHIVE_*


LL_BUILD_DOCTOR_REPORT*.txt
LL_BUILD_SNAPSHOT_*.txt

# Backups / archives (never deploy)
_app_BACKUP_*
app.BACKUP-*
lib.BACKUP-*
_frontend_old/
_ARCHIVE_*/
_patches/
LL_AUDIT_DUMP*.txt
